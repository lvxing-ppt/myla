<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mlms</groupId>
        <artifactId>mlms</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>oes-platform</artifactId>
    <packaging>pom</packaging>
    <name>MLMS Platform (聚合)</name>
    <description>业务模块聚合 — gateway(仪器网关) + sample(样本) + result(结果) + workflow(工作流) + lis(LIS对接) + report(报告) + notification(通知) + admin(管理)</description>
    <modules>
        <module>oes-gateway</module>
        <module>oes-sample</module>
        <module>oes-result</module>
        <module>oes-workflow</module>
        <module>oes-lis</module>
        <module>oes-report</module>
        <module>oes-notification</module>
        <module>oes-admin</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.mlms</groupId>
                <artifactId>oes-common</artifactId>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>3.2.1</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>com.mlms</groupId>
            <artifactId>oes-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>3.2.1</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
